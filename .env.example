# Holy Spirit Prayers — environment example
# Copy to .env (gitignored) and fill in real values for local dev,
# or set the same variables in Railway → Variables in production.

# Server port (Railway sets this automatically)
# PORT=5000

# Public origin for absolute URLs (used by Stripe success/cancel redirects).
# Optional — falls back to the request Origin / Host header when unset.
# BASE_URL=https://your-app.up.railway.app

# Canonical site URL for SEO (canonical links, OG/Twitter URLs, sitemap.xml,
# robots.txt Sitemap directive). Optional — defaults to
# https://www.holyspiritprayers.com when unset. Should NOT include a trailing slash.
# SITE_URL=https://www.holyspiritprayers.com

# Stripe — server-side secret for Checkout sessions.
# Required for the monthly subscription CTA on the homepage.
STRIPE_SECRET_KEY=

# Optional Stripe Price ID for the $27/month plan.
# When set, the server uses this price; otherwise it falls back to
# inline price_data of USD 2700/month with product name
# "Holy Spirit Prayers Monthly Subscription".
STRIPE_MONTHLY_PRICE_ID=

# Optional Stripe Price ID for the $7 one-time prayer purchase. When unset,
# the server creates an inline price_data of USD 700 per prayer with the
# product name "Holy Spirit Prayer — <title>".
STRIPE_PRAYER_PRICE_ID=

# Webhook signing secret for /api/stripe/webhook (Stripe Dashboard → Developers
# → Webhooks → Signing secret). REQUIRED in production — the webhook handler
# fails closed without it. In development the handler will accept unsigned
# events with a console warning so you can test from the dashboard.
#
# Configure the Stripe Dashboard endpoint to POST to
#   https://your-host.example.com/api/stripe/webhook
# subscribed to at minimum:
#   - checkout.session.completed
#   - customer.subscription.created
#   - customer.subscription.updated
#   - customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Stripe promotion codes are enabled on every Checkout session
# (subscription + one-time prayer purchase) via allow_promotion_codes=true.
# A live promotion code "777" (coupon XZZ7DYLz, promo
# promo_1TURfn0UQQxbBLNItYrq0gEE) gives 100% off the monthly subscription —
# customers can enter it on the Stripe Checkout page.

# Optional — frontend Stripe publishable key (must be VITE_-prefixed).
# VITE_STRIPE_PUBLISHABLE_KEY=

# Optional — secret reserved for future signed-cookie / JWT session work.
# The current in-memory session store does not require it; passwords are
# salted+hashed with Node's built-in scrypt regardless of this value.
# SESSION_SECRET=change-me-to-a-long-random-string

# Uploads directory for admin-uploaded MP3s and companion PDFs.
# Optional — defaults to ./uploads relative to the server's working directory
# for local development. On Railway, attach a Volume mounted at /data and set
# UPLOADS_DIR=/data/uploads so audio/PDF files survive redeploys and restarts.
# The directory is created recursively at startup if it does not exist.
# UPLOADS_DIR=/data/uploads

# Admin console credentials. Used to gate the admin MP3 upload page at
# /#/admin/uploads (POST/DELETE /api/uploaded-prayers). The defaults below
# match the prototype credentials baked into server/admin-auth.ts; override
# them in production via these env vars.
ADMIN_USERNAME=Caleb
ADMIN_PASSWORD=HeartNoah
